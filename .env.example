# Nexus Terminal — provedores locais (sem Google Cloud)
# Copie para .env e preencha. Nunca committe o .env.
#
# Chave do 9Router nesta máquina:
#   C:\Users\Jean\Projetos\chat-ia\env\.env  (ROUTER_API_KEY)

# --- 9Router (OpenAI-compat) ---
ROUTER_BASE_URL=http://127.0.0.1:20128/v1
ROUTER_API_KEY=sk-COLE_SUA_ROUTER_API_KEY_AQUI
ROUTER_MODEL=cx/gpt-5.6-sol

# --- Ollama (API nativa em 127.0.0.1:11434) ---
# Subir: npm run ollama:serve   ou   ollama serve
# Docs: https://github.com/ollama/ollama/blob/main/docs/api.md
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:3b-instruct

APP_URL=http://127.0.0.1:3000
